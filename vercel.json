{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "movimento.escola-3s.pt"
        }
      ],
      "destination": "/movimento/:path*"
    }
  ],
  "headers": [
    {
      "source": "/movimento/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/futsal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/futsal",
      "destination": "/futsal/",
      "permanent": false
    },
    {
      "source": "/movimento",
      "destination": "/movimento/",
      "permanent": false
    }
  ]
}